name: Build APK

on:
  workflow_dispatch:
  push:
    branches: [main, master]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-24.04
    steps:
      - name: Checkout do repositório
        uses: actions/checkout@v4

      - name: Preparar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Preparar Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: platform-tools

      - name: Preparar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Instalar componentes Android
        run: sdkmanager "platforms;android-35" "build-tools;35.0.0"

      - name: Extrair projeto do ZIP
        shell: bash
        run: |
          set -Eeuo pipefail
          if [ ! -f "JH-Clip-Studio.zip" ]; then
            echo "::error::Coloque JH-Clip-Studio.zip na raiz do repositório."
            find . -maxdepth 3 -type f | sort | head -150
            exit 1
          fi
          mkdir -p extracted-project
          unzip -oq JH-Clip-Studio.zip -d extracted-project
          if [ -f extracted-project/JHClipStudio/settings.gradle.kts ]; then
            echo "PROJECT_DIR=extracted-project/JHClipStudio" >> "$GITHUB_ENV"
          elif [ -f extracted-project/settings.gradle.kts ]; then
            echo "PROJECT_DIR=extracted-project" >> "$GITHUB_ENV"
          else
            echo "::error::Não encontrei settings.gradle.kts dentro do ZIP."
            find extracted-project -maxdepth 5 -type f | sort | head -200
            exit 1
          fi

      - name: Compilar APK de depuração
        shell: bash
        run: |
          set -Eeuo pipefail
          cd "$PROJECT_DIR"
          gradle assembleDebug --no-daemon --stacktrace --warning-mode all 2>&1 | tee "$GITHUB_WORKSPACE/build.log"

      - name: Preparar APK para download
        if: success()
        run: |
          set -Eeuo pipefail
          mkdir -p output
          cp "$PROJECT_DIR/app/build/outputs/apk/debug/app-debug.apk" output/JH-Clip-Studio.apk
          ls -lh output/JH-Clip-Studio.apk

      - name: Enviar APK como artefato
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: JH-Clip-Studio-APK
          path: output/JH-Clip-Studio.apk
          if-no-files-found: error

      - name: Mostrar diagnóstico em caso de erro
        if: failure()
        shell: bash
        run: |
          echo "===== DIAGNÓSTICO DA COMPILAÇÃO ====="
          if [ -f build.log ]; then tail -n 250 build.log; fi
          find . -maxdepth 5 -type f | sort | head -300

      - name: Enviar log da compilação em caso de falha
        if: failure() && hashFiles('build.log') != ''
        uses: actions/upload-artifact@v4
        with:
          name: JH-Clip-Studio-build-log
          path: build.log
          if-no-files-found: warn
